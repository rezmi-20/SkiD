# Local development values are placeholders. Copy to .env.local and replace each
# value with credentials for a development database and test integrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://AUTH_PROJECT.example
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
NEON_AUTH_SESSION_DATA_TTL_SECONDS=604800
NEON_AUTH_SESSION_FETCH_TIMEOUT_MS=5000
NEON_AUTH_SESSION_FETCH_RETRIES=1

# Public application origins. These are not credentials.
NEXT_PUBLIC_APP_URL=https://your-app.example
NEXT_PUBLIC_BASE_URL=https://your-app.example
BASE_URL=https://your-app.example
CALLBACK_URL=https://your-app.example
CORS_ALLOWED_ORIGINS=https://your-app.example

# Payment provider credentials. Keep secret values server-side.
CHAPA_SECRET_KEY=replace-with-chapa-secret-key
CHAPA_WEBHOOK_SECRET=replace-with-chapa-webhook-secret
CHAPA_WEBHOOK_URL=https://your-app.example/api/payment/webhook
WEBHOOK_URL=https://your-app.example/api/payment/webhook
NEXT_PUBLIC_CHAPA_PUBLIC_KEY=replace-with-chapa-public-key

# Fayda identity encryption and fingerprint keys (each key must decode to 32 bytes).
FIN_HMAC_KEY=replace-with-32-byte-base64-or-hex-key
FIN_ENCRYPTION_KEYS=v1:replace-with-32-byte-base64-or-hex-key
FIN_ENCRYPTION_KEY_ID=v1

# Cloudinary upload storage (cloud name is public; API credentials are private).
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
TRUSTED_UPLOAD_HOSTS=res.cloudinary.com

# Admin sessions should use a dedicated secret in deployed environments.
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
OWNER_SUPER_ADMIN_EMAIL=owner@example.test
